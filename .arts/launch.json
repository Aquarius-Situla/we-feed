    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: WeFeed 本地启动",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": ["-init", "True", "-job", "False"],
            "env": {
                "GATHER.CLEAN_HTML": "True",
                "WERSS_AUTH_WEB": "False",
                "RSS_LOCAL": "True",
                "HEADLESS": "False",
                "DEBUG": "False",
                "BROWSER_TYPE": "webkit",
                "GATHER.CONTENT_AUTO_CHECK": "True",
                "GATHER.CONTENT_AUTO_INTERVAL": "1",
                "THREADS": "2"
            }
        }
    ]
}